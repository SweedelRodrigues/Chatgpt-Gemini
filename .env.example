# ==============================================================================
# GenAI Cloud Gateway - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file or your API keys to version control!

# Gemini API Credentials
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Credentials (powers the ChatGPT-labelled comparison panel)
# Get your API key from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Application Configuration
APP_NAME="GenAI Cloud Gateway"
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Gateway Default Parameters
DEFAULT_MODEL=gemini-2.5-flash-lite
MAX_PROMPT_LENGTH=4000
REQUEST_TIMEOUT_SECONDS=30.0
